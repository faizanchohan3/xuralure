# Copy this file to .env and fill in your BigCommerce API credentials.
# Create them in BigCommerce: Settings > API > Store-level API accounts > Create API account.
# Required scope: Products = read-only. Nothing else is needed.

# From the API path https://api.bigcommerce.com/stores/{STORE_HASH}/v3/
BC_STORE_HASH=
BC_ACCESS_TOKEN=

# How often the running server re-syncs prices and stock from BigCommerce (minutes)
BC_SYNC_MINUTES=15

PORT=4321
